# Database Configuration
DATABASE_URL="postgresql://postgres:1234@localhost:5432/jobsconnect?schema=public"

# Embedding Model (PhoBERT)
EMBEDDING_MODEL="VoVanPhuc/sup-SimCSE-VietNamese-phobert-base"

# Recommendation Settings
TOP_K_JOBS=20

# Scheduler Settings (in hours)
SCHEDULE_INTERVAL_HOURS=12

# Batch Size for Processing (increased for better performance)
BATCH_SIZE=300

# Number of Worker Processes for Multiprocessing
# 0 = disable multiprocessing, -1 = use all CPU cores, N = use N cores
NUM_WORKERS=4
